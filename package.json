{
  "name": "chart-terminal",
  "private": true,
  "engines": { "node": ">=24" },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts src/tools/*.test.ts src/pine/*.test.ts src/pine/lib/*.test.ts src/mql/*.test.ts src/mql/*/*.test.ts src/ninja/*.test.ts src/ninja/*/*.test.ts src/tester/*.test.ts src/python/*.test.ts src/orderflow/*.test.ts src/journal/*.test.ts src/risk/*.test.ts src/derivs/*.test.ts src/broker/*.test.ts src/market/*.test.ts src/ai/*.test.ts src/skills/*.test.ts",
    "server": "node server/index.ts",
    "test:server": "npm --prefix server test",
    "check:ir": "node server/iran/check.ts",
    "check:dominance": "node server/dominance/check.ts",
    "audit:html": "node scripts/audit-html.mjs",
    "bench": "node --experimental-strip-types --expose-gc scripts/bench.ts",
    "build:lite": "node lite/build.mjs",
    "build:android-standalone": "node android/build-standalone.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "lightweight-charts": "5.0.8"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
