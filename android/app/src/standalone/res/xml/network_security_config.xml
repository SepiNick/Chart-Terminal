<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone flavor: HTTPS only (no cleartext at all), system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
