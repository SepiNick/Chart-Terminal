{
  "name": "chart-terminal-desktop",
  "productName": "Chart Terminal",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.1.1",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/SepiNick/tradingview-clone",
  "description": "Chart Terminal desktop app",
  "author": "Chart Terminal",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder",
    "dist:win": "node build.mjs && electron-builder --win",
    "dist:win:signed": "node sign-check.mjs && node build.mjs && electron-builder --win",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:linux": "node build.mjs && electron-builder --linux"
  },
  "dependencies": {
    "ccxt": "4.5.88",
    "electron-updater": "6.8.11",
    "nodemailer": "^10.1.7",
    "web-push": "^3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "app.chartterminal.desktop",
    "productName": "Chart Terminal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Chart Terminal",
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice notes in the trading journal"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance",
      "icon": "build/icon.png",
      "maintainer": "Chart Terminal"
    },
    "extraResources": [
      {
        "from": "install-python.ps1",
        "to": "install-python.ps1"
      }
    ]
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
